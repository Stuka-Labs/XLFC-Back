{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "./lib",
    "rootDir": "./",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "noImplicitAny": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": "./"
  },
  "compileOnSave": true,
  "include": [
    "src/**/*",
    "build-prod.ts"
  ],
  "exclude": [
    "node_modules",
    "lib"
  ]
}